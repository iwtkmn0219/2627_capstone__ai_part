# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#
# .env 를 읽는 것은 진입점 스크립트의 책임이다. smoke_gemini.py 와
# list_models.py 가 load_dotenv() 를 호출한다. 라이브러리(llm/, stt/)는
# 환경변수를 읽기만 하므로, 새 진입점을 만들면 load_dotenv() 를 직접 부를 것.

# --- Gemini (LLM) -----------------------------------------------------------

# 필수. Google AI Studio (https://aistudio.google.com/apikey) 에서 발급.
GEMINI_API_KEY=

# 선택. 주석을 풀면 llm/gemini.py 의 DEFAULT_MODEL 을 덮어쓴다.
# 모델이 종료되면 코드가 아니라 여기서 갈아끼운다.
# (gemini-3.1-flash-lite 는 2027-05-07 종료 예정. 캡스톤 종료가 2027-06 이므로
#  출시 전 반드시 재검증할 것)
#
# 주의: 값 없이 GEMINI_MODEL= 만 남기면 빈 문자열이 모델명으로 들어가 호출이 깨진다.
#       쓰지 않을 거면 주석 상태로 둘 것.
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- CLOVA Speech (STT) -----------------------------------------------------

# 둘 다 필수. NAVER Cloud Platform > CLOVA Speech 에서 도메인을 만들면
# Invoke URL 과 Secret Key 가 함께 발급된다.
# 없으면 ClovaSTT 인스턴스를 만드는 시점에 KeyError 로 죽는다. (import 시점 아님)
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
